#!/usr/bin/env python3
"""Which crates a PR changed, for the CI job graph.

usage: script/ci-changes --base <sha> [--head <sha>] [--labels <json list>]

Prints key=json lines (and appends them to $GITHUB_OUTPUT when set):
  crates    workspace members that changed, sorted
  tested    those with tests: the test archive and its groups hold only these
  libs      those whose library runs doctests (not `doctest = false`)
  measured  those that get a coverage report: [{name, dir}]
  new_tests crates whose tests/ gained lines: the duplicate check runs for these only
  api       a public-API snapshot may have changed
  manifests a Cargo.toml or Cargo.lock changed (repo-layer check)
  excluded  crates outside the workspace whose own suite runs: [{dir, workdir, kind}]
  services  databases the crates' tests need
  groups    crates split by the databases they need: [{name, crates, services, slot}];
            slot (1-6) is the group's archive artifact in tests.yaml
  all       every crate counts as changed
  book      the book changed
  ci_self   CI's own files changed: the ci-self job checks them
  versions  {crate: [old, new]} for changed crates whose version moved
  touched   crates the PR changed files in (crates is wider under the label
            or a global change)
  touched_excluded  excluded crate dirs the PR changed files in
  published touched crates that go to crates.io (not `publish = false`),
            excluded crates included
  unbumped  of those, the ones whose version didn't change (the PR fails)
  no_changelog bumped ones whose CHANGELOG.md has no `## <version>` (the PR fails)
  changelogs {crate: {path, text}}: each bumped crate's entry, as one line
  gated     the ALL_TESTS label is set

The repo's own settings, from .github/ci-crates.yaml (defaults suit vantage):
  runner, build_runner, small_runner  runner labels (ubuntu-26.04)
  env       extra env for every cargo job ({})
  setup     .github/ci-setup.sh exists: shared cargo jobs run it (apt packages)
  cache     rust-cache | warpbuild (rust-cache)
  warm      post-merge cache warming: changed | full-on-miss (changed)
  internal_tests  forbid | allow: may a PR add tests under src/ (forbid)
  one_job   `one_job: true` and at most one test group: the suite builds and
            tests in place, with no archive (false)
  suite_exclude  nextest filter the suites and the matrix don't run, for tests
            run elsewhere ("")
  skill_url the duplicate-test cleanup skill the summary links to
  flags     {name: bool}: config `flags: {name: [crates]}`, true when one of
            them is tested (gates a repo's own jobs)
  labels    the PR's labels (gate a repo's own jobs on one)
  versioning_mode  crates | app | none (crates)
  app       app mode: {crate, old, new, owed, heading, changelog, plist,
            plist_ok, skip_label, skipped}; owed means the PR changed a crate, the root
            Cargo.toml or the lockfile's outside packages

A file belongs to the crate whose directory holds it, longest prefix first,
so a version bump in a crate's Cargo.toml or CHANGELOG.md selects that crate.
In app mode the app's own version bump (its version line, the plist) selects
nothing. Cargo.lock selects nothing when only workspace members' versions
moved; any other lockfile change means every crate changed. With
`dependents: true` every member depending on a changed one, however
indirectly, is changed too. .github/ci-crates.yaml holds the global paths, the
database map and the excluded crates.
"""
import plistlib
import argparse
import fnmatch
import json
import os
import re
import subprocess
import sys
import tomllib

import yaml

# The workspace is wherever this runs, not where the script lives: another repo
# runs it from a checkout of vantage under .ci/.
ROOT = subprocess.run(["git", "rev-parse", "--show-toplevel"], check=True, capture_output=True,
                      text=True).stdout.strip()
LABEL = "ALL_TESTS"
SKILL_URL = "https://github.com/romaninsh/vantage/blob/main/coverage/matrix-rs/skills/matrix-based-test-cleanup/SKILL.md"


def run(*cmd):
    return subprocess.run(cmd, cwd=ROOT, check=True, capture_output=True, text=True).stdout


def versions(names, dirs, base, head):
    """{crate: [old, new]} for changed crates whose version moved; old is
    null for a crate that didn't exist at base."""
    out = {}
    for name in names:
        old, new = versions_of(name, dirs, base), versions_of(name, dirs, head)
        if old != new:
            out[name] = [old, new]
    return out


def changelog_entry(text, heading, limit=400):
    """The section under `heading` (say `## 1.2.3`) of a CHANGELOG as one plain
    line, or None when there's no such heading."""
    match = re.search(rf"^{re.escape(heading)}( [^\n]*)?\n(.*?)(?=^## |\Z)", text or "", re.M | re.S)
    if not match:
        return None
    body = re.sub(r"(?m)^\s*[-*] ", "• ", re.sub(r"`|\*\*", "", match.group(2)))
    plain = re.sub(r"\s+", " ", body).strip()
    return plain if len(plain) <= limit else plain[: limit - 1].rstrip() + "…"


def show(rev, path):
    try:
        return run("git", "show", f"{rev}:{path}")
    except subprocess.CalledProcessError:
        return ""


def has_tests(directory):
    """A tests/ dir, or a test attribute anywhere under src/."""
    if os.path.isdir(os.path.join(ROOT, directory, "tests")):
        return True
    for root, _, names in os.walk(os.path.join(ROOT, directory, "src")):
        for n in names:
            if n.endswith(".rs") and ("#[test]" in (text := open(os.path.join(root, n)).read())
                                      or "#[tokio::test" in text):
                return True
    return False


def members():
    """({name: dir}, names whose library has doctests, names with tests) for the workspace."""
    meta = json.loads(run("cargo", "metadata", "--no-deps", "--format-version", "1"))
    ids = set(meta["workspace_members"])
    packages = [p for p in meta["packages"] if p["id"] in ids]
    dirs = {p["name"]: os.path.relpath(os.path.dirname(p["manifest_path"]), ROOT) for p in packages}
    # `doctest = false` on the library is the crate saying its examples aren't doctests.
    libs = {
        p["name"] for p in packages
        if any(("lib" in t["kind"] or "proc-macro" in t["kind"]) and t.get("doctest", True) for t in p["targets"])
    }
    tested = {name for name, d in dirs.items() if has_tests(d)}
    # `publish = false` shows as an empty list; null means crates.io.
    published = {p["name"] for p in packages if p.get("publish") != []}
    # Path dependencies on other members, every kind: what a member's change reaches.
    deps = {p["name"]: {d["name"] for d in p["dependencies"] if d.get("path") and d["name"] in dirs}
            for p in packages}
    return dirs, libs, tested, published, deps


def dependents(changed, deps):
    """`changed` plus every member that depends on one of them, however indirectly."""
    users = {}
    for name, needs in deps.items():
        for n in needs:
            users.setdefault(n, set()).add(name)
    out, todo = set(changed), list(changed)
    while todo:
        for user in users.get(todo.pop(), ()):
            if user not in out:
                out.add(user)
                todo.append(user)
    return out


def version_only(base, head, path):
    """The Cargo.toml changes nothing but [package] version: parsed, not by
    line, so a dependency's `version = ` in a [dependencies.x] table counts."""
    def without_version(rev):
        manifest = tomllib.loads(show(rev, path) or "")
        manifest.get("package", {}).pop("version", None)
        return manifest
    return without_version(base) == without_version(head)


def app_version(settings, dirs, base, head, owed, labels):
    """App mode's one version: the app crate's, with its CHANGELOG block and plist."""
    name = settings["crate"]
    old, new = versions_of(name, dirs, base), versions_of(name, dirs, head)
    major, minor = (new or "0.0").split(".")[:2]
    path = settings.get("changelog", "CHANGELOG.md")
    heading = settings.get("heading", "## {major}.{minor}").format(major=major, minor=minor, version=new)
    text = changelog_entry(show(head, path), heading) if new else None
    plist = plist_ok = None
    if settings.get("plist"):
        info = plistlib.loads(show(head, settings["plist"]).encode() or b"<plist><dict/></plist>")
        plist = info.get("CFBundleShortVersionString")
        plist_ok = plist == new and info.get("CFBundleVersion") == new
    return {
        "crate": name, "old": old, "new": new, "owed": owed, "heading": heading,
        "changelog": {"path": path, "text": text} if text is not None else None,
        "plist": plist, "plist_ok": plist_ok if plist_ok is not None else True,
        "skip_label": settings.get("skip_label"), "skipped": settings.get("skip_label") in labels,
    }


def versions_of(name, dirs, rev):
    text = show(rev, f"{dirs[name]}/Cargo.toml")
    return tomllib.loads(text).get("package", {}).get("version") if text else None


def excluded(config):
    """{crate dir: suite entry} for the excluded crates CI knows."""
    out = {}
    for path, settings in (config.get("excluded") or {}).items():
        settings = settings or {}
        workdir = settings.get("workdir", path)
        if os.path.isfile(os.path.join(ROOT, workdir, "Cargo.toml")):
            out[path] = {"dir": path, "workdir": workdir, "kind": settings.get("kind", "plain")}
    return out


def matches(path, patterns):
    return any(fnmatch.fnmatch(path, p) for p in patterns)


def lock_is_global(old, new, member_names):
    """True when Cargo.lock's packages outside the workspace differ. Members'
    own entries (versions, dependency lists) follow their Cargo.toml, which
    already selects them."""
    def outside(text):
        packages = tomllib.loads(text).get("package", []) if text else []
        return {json.dumps(p, sort_keys=True) for p in packages if p["name"] not in member_names}
    return outside(old) != outside(new)


def classify(files, locks, crates, libs, tested, outside, config, labels, adds=None, deps=None, unselect=()):
    """`unselect`: files that select no crate (app mode's own version bump)."""
    files = [f for f in files if f not in unselect]
    by_dir = sorted(((d, n) for n, d in crates.items()), key=lambda x: -len(x[0]))
    outside_dirs = sorted(outside, key=len, reverse=True)
    changed, changed_outside, tests_changed = set(), set(), set()
    everything = LABEL in labels
    book = ci_self = False
    for f in files:
        if f == "Cargo.lock":
            # Excluded crates show up as path dependencies: ours, not external.
            ours = set(crates) | {os.path.basename(d) for d in outside}
            everything |= lock_is_global(*locks, ours)
            continue
        if matches(f, config.get("global", [])):
            everything = True
        ci_self |= matches(f, config.get("ci_self", []))
        book |= matches(f, config.get("book", []))
        owner = next((n for d, n in by_dir if f.startswith(d + "/")), None)
        if owner:
            changed.add(owner)
            # Only added lines can add a test: a tests/ diff that only deletes
            # can't make a duplicate, so it doesn't need the matrix.
            if f.startswith(crates[owner] + "/tests/") and (adds is None or f in adds):
                tests_changed.add(owner)
            continue
        owner = next((d for d in outside_dirs if f.startswith(d + "/")), None)
        if owner:
            changed_outside.add(owner)
    # A version bump is owed only for files the PR changed in the crate itself,
    # not for crates the label or a global file pulled in.
    touched, touched_outside = sorted(changed), sorted(changed_outside)
    if config.get("dependents"):
        changed = dependents(changed, deps or {})
    if everything:
        changed = set(crates)
    # Without the label an excluded crate runs only when it changed.
    if LABEL in labels:
        changed_outside = set(outside)
    service_map = config.get("services", {})
    services = sorted({s for c in changed for s in service_map.get(c, [])})
    groups = {}
    # Only crates with tests go into the test archive and its groups.
    for c in sorted(changed & tested):
        need = tuple(sorted(service_map.get(c, [])))
        groups.setdefault(need, []).append(c)
    snapshots = set(config.get("api_inputs", []))
    unmeasured = config.get("coverage_ignore", [])
    return {
        "crates": sorted(changed),
        "tested": sorted(changed & tested),
        "libs": sorted(changed & libs),
        "measured": [{"name": c, "dir": crates[c]} for c in sorted(changed) if not matches(c, unmeasured)],
        # Only these can have new tests, so only these need the duplicate check.
        "new_tests": [{"name": c, "dir": crates[c]} for c in sorted(tests_changed)],
        "api": bool(changed & snapshots) or any(f.startswith("api/") for f in files),
        "manifests": any(os.path.basename(f) in ("Cargo.toml", "Cargo.lock") for f in files),
        "excluded": [outside[d] for d in sorted(changed_outside)],
        "services": services,
        # The slot is the group's archive artifact: tests.yaml has six.
        "groups": [
            {"name": "-".join(need) or "plain", "crates": cs, "services": list(need), "slot": i}
            for i, (need, cs) in enumerate(sorted(groups.items()), 1)
        ],
        "touched": touched,
        "touched_excluded": touched_outside,
        "all": everything,
        "book": book,
        "ci_self": ci_self,
        "gated": LABEL in labels,
    }


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--base", required=True)
    ap.add_argument("--head", default="HEAD")
    ap.add_argument("--labels", default="[]")
    a = ap.parse_args()
    config = yaml.safe_load(open(os.path.join(ROOT, ".github", "ci-crates.yaml")))
    span = f"{a.base}...{a.head}"
    files = run("git", "diff", "--name-only", span).split()
    base = run("git", "merge-base", a.base, a.head).strip()
    locks = [show(base, "Cargo.lock"), show(a.head, "Cargo.lock")] if "Cargo.lock" in files else ["", ""]
    dirs, libs, tested, published, deps = members()
    labels = json.loads(a.labels)
    # Files the diff adds lines to ("-" marks a binary file; count it).
    adds = {p for n, _, p in (row.split("\t", 2) for row in run("git", "diff", "--numstat", span).splitlines())
            if n != "0"}
    versioning = config.get("versioning") or {}
    mode = versioning.get("mode", "crates")
    unselect = set()
    if mode == "app":
        # Every PR bumps the app: the bump alone tests nothing.
        app_toml = f"{dirs[versioning['crate']]}/Cargo.toml"
        if app_toml in files and version_only(base, a.head, app_toml):
            unselect.add(app_toml)
        if versioning.get("plist"):
            unselect.add(versioning["plist"])
    out = classify(files, locks, dirs, libs, tested, excluded(config), config, labels, adds, deps, unselect)
    if len(out["groups"]) > 6:
        print(f"::error::{len(out['groups'])} test groups; tests.yaml has 6 archive slots", file=sys.stderr)
        return 1
    # Excluded crates release too: check them by their own Cargo.toml.
    outside_names = {}
    for entry in out["excluded"]:
        if entry["dir"] not in out["touched_excluded"]:
            continue
        manifest = tomllib.loads(show(a.head, f"{entry['workdir']}/Cargo.toml") or "").get("package", {})
        if manifest.get("name") and manifest.get("publish", True) is not False:
            dirs.setdefault(manifest["name"], entry["workdir"])
            outside_names[manifest["name"]] = entry["workdir"]
    # Per-crate versions only in crates mode; app mode has one version, below.
    checked = sorted((set(out["touched"]) & published) | set(outside_names)) if mode == "crates" else []
    out["versions"] = versions(checked, dirs, base, a.head)
    out["published"] = checked
    out["unbumped"] = [c for c in checked if c not in out["versions"]]
    out["changelogs"] = {}
    for c, (_, new) in sorted(out["versions"].items()):
        entry = changelog_entry(show(a.head, f"{dirs[c]}/CHANGELOG.md"), f"## {new}")
        if entry is not None:
            out["changelogs"][c] = {"path": f"{dirs[c]}/CHANGELOG.md", "text": entry}
    out["no_changelog"] = [c for c in sorted(out["versions"]) if c not in out["changelogs"]]

    # Pinned, not `latest`: the alias moves between Ubuntu releases on its own.
    runner = config.get("runner", "ubuntu-26.04")
    out["runner"] = runner
    out["build_runner"] = config.get("build_runner", runner)
    out["small_runner"] = config.get("small_runner", "ubuntu-26.04")
    out["env"] = config.get("env") or {}
    out["setup"] = os.path.isfile(os.path.join(ROOT, ".github", "ci-setup.sh"))
    out["cache"] = config.get("cache", "rust-cache")
    out["warm"] = config.get("warm", "changed")
    out["internal_tests"] = config.get("internal_tests", "forbid")
    out["suite_exclude"] = config.get("suite_exclude", "")
    # One group needs no archive: its suite builds and tests in place.
    out["one_job"] = bool(config.get("one_job")) and len(out["groups"]) <= 1
    out["skill_url"] = config.get("skill_url", SKILL_URL)
    # A repo's own jobs gate on these: each flag is true when one of its crates is tested.
    out["flags"] = {name: bool(set(crates) & set(out["crates"])) for name, crates in (config.get("flags") or {}).items()}
    # The PR's labels as read at the start of the run: a repo's own jobs gate on them.
    out["labels"] = sorted(labels)
    out["versioning_mode"] = mode
    out["app"] = {}
    if mode == "app":
        # The app's version is owed for any crate change, the root manifest, or a
        # lockfile change outside the workspace (a dependency bump ships too).
        ours = set(dirs) | {os.path.basename(d) for d in excluded(config)}
        lock = "Cargo.lock" in files and lock_is_global(*locks, ours)
        owed = bool(out["touched"]) or "Cargo.toml" in files or lock
        out["app"] = app_version(versioning, dirs, base, a.head, owed, labels)
    lines = [f"{k}={json.dumps(v, separators=(',', ':'))}" for k, v in out.items()]
    print("\n".join(lines))
    if os.environ.get("GITHUB_OUTPUT"):
        with open(os.environ["GITHUB_OUTPUT"], "a") as f:
            f.write("\n".join(lines) + "\n")


if __name__ == "__main__":
    sys.exit(main())
